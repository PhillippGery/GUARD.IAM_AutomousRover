# ROS2 build artifacts
build/
install/
log/

# Python
__pycache__/
*.py[cod]
*.pyo
.env
venv/
.venv/
*.egg-info/
dist/

# Arduino
*.hex
*.elf
*.bin

# CAD — tracked via Git LFS (STL, STEP, SolidWorks, Fusion 360)
# Real files are committed through LFS; only temp/backup/lock files ignored here.
# SolidWorks backups and auto-recover files
*.sldprt.bak
*.sldasm.bak
*.slddrw.bak
~$*.sldprt
~$*.sldasm
~$*.slddrw
# Fusion 360 local cache
*.f3d.bak
# STEP/STL exports that are gitignored EXCEPT the ROS2 mesh exceptions below
*.[Ss][Tt][Ee][Pp]
*.[Ss][Tt][Pp]
# ...except generated sim meshes that must ship with the repo for robot_state_publisher
!30_ros2_ws/src/guardian_description/meshes/**

# OS
.DS_Store
Thumbs.db

# Editors
.vscode/
.idea/
*.swp
*.bak
*~
