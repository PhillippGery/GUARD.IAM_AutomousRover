[Unit]
Description=GUARDIAN foxglove_bridge — browser control interface entry point
After=network.target

[Service]
Type=simple
ExecStart=/bin/bash -c 'source %h/GUARD.IAM_AutomousRover/60_scripts/guardiam_env.sh && exec ros2 launch foxglove_bridge foxglove_bridge_launch.xml port:=8765 address:=0.0.0.0'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
