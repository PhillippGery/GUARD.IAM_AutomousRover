# GUARDIAN stable device names — arms + wrist cameras
# Arms are serial-keyed (unique per controller, survives replug/hub changes).
# Cameras are port-keyed (their serials collide), so each camera must stay in
# its assigned USB socket. Regenerate camera rules with identify_arm_cam_ports.sh
# if the hub layout changes.
#
# Arm identities re-verified by hand on 2026-07-31.
# Camera ports re-verified by hand on 2026-08-02 (visually confirmed each feed
# after the cameras shuffled ports during arm repair work).

# --- Arm controllers (CH340 serial) ---
SUBSYSTEM=="tty", ATTRS{serial}=="5A7C121109", SYMLINK+="guardian_left_follower"
SUBSYSTEM=="tty", ATTRS{serial}=="5AE6052838", SYMLINK+="guardian_right_follower"
SUBSYSTEM=="tty", ATTRS{serial}=="5AE6083896", SYMLINK+="guardian_right_leader"
SUBSYSTEM=="tty", ATTRS{serial}=="5AB0157450", SYMLINK+="guardian_left_leader"

# --- Wrist + overhead cameras (port-keyed) ---
SUBSYSTEM=="video4linux", KERNELS=="5-1.4:1.0", ATTR{index}=="0", SYMLINK+="cam_overhead"
SUBSYSTEM=="video4linux", KERNELS=="3-2.1:1.0", ATTR{index}=="0", SYMLINK+="cam_right_wrist"
SUBSYSTEM=="video4linux", KERNELS=="3-2.2:1.0", ATTR{index}=="0", SYMLINK+="cam_left_wrist"




# >>> GUARDIAN-AUTO >>>   (generated by identify_arm_cam_ports.sh — edit above/below, not inside)
# Arms: serial-keyed (robust). Cameras: serial- or port-keyed per detection.
SUBSYSTEM=="tty", ATTRS{serial}=="5A7C121109", SYMLINK+="guardian_left_follower"
SUBSYSTEM=="tty", ATTRS{serial}=="5AE6052838", SYMLINK+="guardian_right_follower"

SUBSYSTEM=="video4linux", KERNELS=="3-2.1:1.0", ATTR{index}=="0", SYMLINK+="cam_right_wrist"
SUBSYSTEM=="video4linux", KERNELS=="3-2.2:1.0", ATTR{index}=="0", SYMLINK+="cam_left_wrist"
SUBSYSTEM=="video4linux", KERNELS=="5-1.2:1.0", ATTR{index}=="0", SYMLINK+="cam_overhead"
# <<< GUARDIAN-AUTO <<<
