<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>guardian_teleop</name>
  <version>0.1.0</version>
  <description>Meta Quest 3 and joystick teleoperation for GUARDIAN</description>
  <maintainer email="phillipp@example.com">Phillipp Gery</maintainer>
  <license>MIT</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <!-- keyboard_teleop_node reads /dev/input directly for real key
       press/release events (a terminal has no key-up event at all) -->
  <exec_depend>python3-evdev</exec_depend>
  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
